# ==========================================
# Healthcare AI Assistant Environment Variables
# ==========================================

# AI Provider Keys (At least one recommended for live LLM responses)
# If no key is provided, the application operates in High-Precision Clinical Demo Mode using verified dataset RAG.

# Google Gemini API Key (Recommended - fast, high token limit)
# Get yours at: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenAI API Key (Alternative)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Groq API Key (Ultra-fast inference)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=

# Active AI Provider Model selection: "auto" | "gemini" | "openai" | "groq" | "demo"
NEXT_PUBLIC_AI_PROVIDER=auto

# Application Configuration
NEXT_PUBLIC_APP_NAME="CarePulse AI Health Assistant"
NEXT_PUBLIC_DEFAULT_COUNTRY="US"
